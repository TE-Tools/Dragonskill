+    )
+
+    local list = gd and gd.enhancements
+    if not list or #list == 0 then
+        local fs = self:GetExtraFS(90)
+        fs:SetPoint("TOPLEFT", 15, y)
+        fs:SetText(Theme:Hex(Theme.textMuted) .. "Keine VZ-/Sockel-Daten für diese Spec.|r")
+        fs:Show()
