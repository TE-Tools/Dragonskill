From 1e4cb47733af285c5c3a8dbf4ffca87057030e66 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Sat, 5 Sep 2026 07:27:08 +0000
Subject: [PATCH 3/3] fix(ui): stop header title/subtitle overlap, add
 BiS-lookup diagnostics

Every tab's header called SetHeader(title, subtitle), but content.title and
content.text were both hardcoded to nearly the same TOPLEFT anchor (-14 vs
-15), so the two lines drew on top of each other instead of stacking - the
garbled "DRUID / Wiederherstellung" overlap on Dashboard and the same
overlap on Farm Plan (and every other tab) were the same root cause.
content.text now anchors to content.title's BOTTOMLEFT so it always sits
cleanly below the title regardless of font size.

Also added self-diagnosing lookup info to GearManager:GetBiSList()
(GM.lastLookup = {class, specID, reason}) and surfaced it as a "Debug: ..."
line under every "keine Daten geladen" message (Dashboard, Farm Plan,
Upgrades, BiS List). If a spec's BiS list is ever empty again, the reason
(GuideData.lua not loaded / class missing / spec-ID missing / wowhead list
empty) shows up directly in-game instead of a silent blank tab.

Co-Authored-By: Claude Sonnet 5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01Jw8YvG7D4bmDZrNF9ZEio2
---
 DragonSkill/Core/GearManager.lua         | 21 ++++++++++++++++++++
 DragonSkill/Modules/TalentCompare/UI.lua | 25 +++++++++++++++++++-----
 2 files changed, 41 insertions(+), 5 deletions(-)

diff --git a/DragonSkill/Core/GearManager.lua b/DragonSkill/Core/GearManager.lua
index 3b728b4..4b0adf5 100644
--- a/DragonSkill/Core/GearManager.lua
+++ b/DragonSkill/Core/GearManager.lua
@@ -101,6 +101,19 @@ function GearManager:GetBiSList()
     local specID = specIndex and select(1, GetSpecializationInfo(specIndex)) or 0
     local list, seen = {}, {}
 
+    -- Self-diagnosing lookup info surfaced by the UI's empty-state messages
+    -- (e.g. "Kein BiS-Datenstand geladen") so a missing-data report always
+    -- comes with WHY it was missing, instead of a silent blank screen.
+    local reason = nil
+    if not DragonSkillData then
+        reason = "GuideData.lua nicht geladen (DragonSkillData ist nil)"
+    elseif not DragonSkillData[class] then
+        reason = "Keine Daten für Klasse '" .. tostring(class) .. "'"
+    elseif not DragonSkillData[class][specID] then
+        reason = "Keine Daten für Spec-ID " .. tostring(specID) .. " (Klasse " .. tostring(class) .. ")"
+    end
+    self.lastLookup = { class = class, specID = specID, reason = reason }
+
     if DragonSkillData and DragonSkillData[class] and DragonSkillData[class][specID] then
         local bis = DragonSkillData[class][specID].bisGear
         if bis and bis.wowhead then
@@ -132,6 +145,14 @@ function GearManager:GetBiSList()
         end
     end
 
+    -- The class/spec key existed but its wowhead list was empty (or every
+    -- entry got filtered out) - record that too so the diagnostic doesn't
+    -- silently say "no reason" while still returning zero items.
+    if #list == 0 and not reason then
+        reason = "Eintrag für " .. tostring(class) .. "/" .. tostring(specID) .. " vorhanden, aber bisGear.wowhead ist leer"
+        self.lastLookup.reason = reason
+    end
+
     return list
 end
 
diff --git a/DragonSkill/Modules/TalentCompare/UI.lua b/DragonSkill/Modules/TalentCompare/UI.lua
index 9b46f47..d8fba94 100644
--- a/DragonSkill/Modules/TalentCompare/UI.lua
+++ b/DragonSkill/Modules/TalentCompare/UI.lua
@@ -51,6 +51,17 @@ local function ShowUrlPopup(title, url)
     StaticPopup_Show("DRAGONSKILL_URL", nil, nil, url)
 end
 
+-- Small debug helper: turns GearManager's self-diagnosing lookup info
+-- (see GetBiSList) into a one-line suffix so an empty-state message never
+-- just says "nothing here" without saying why.
+local function DiagSuffix(GM)
+    local d = GM and GM.lastLookup
+    if d and d.reason then
+        return "\n" .. Theme:Hex(Theme.textMuted) .. "Debug: " .. tostring(d.reason) .. "|r"
+    end
+    return ""
+end
+
 function UI:Init()
     if self.frame then return end
     local f = CreateFrame("Frame", "DragonSkillMainFrame", UIParent)
@@ -242,7 +253,11 @@ function UI:EnsureText(content)
     end
     if not content.text then
         content.text = content:CreateFontString(nil, "OVERLAY", "GameFontHighlight")
-        content.text:SetPoint("TOPLEFT", 15, -15); content.text:SetWidth(CONTENT_WIDTH - 40); content.text:SetJustifyH("LEFT"); content.text:SetSpacing(5)
+        -- Anchored BELOW the title (not on top of it - content.title sits at
+        -- -14 with a large font, so a hardcoded -15 here used to draw the
+        -- subtitle directly on top of the title text, garbling both).
+        content.text:SetPoint("TOPLEFT", content.title, "BOTTOMLEFT", 0, -6)
+        content.text:SetWidth(CONTENT_WIDTH - 40); content.text:SetJustifyH("LEFT"); content.text:SetSpacing(5)
     end
     return content.text
 end
@@ -362,7 +377,7 @@ function UI:DrawDashboard(content, class, specID)
             end
         else
             local fs = self:GetExtraFS(50); fs:SetPoint("TOPLEFT", 15, y)
-            fs:SetText(Theme:Hex(Theme.textMuted) .. "Kein BiS-Datenstand geladen.|r"); fs:Show(); y = y - ROW_STEP
+            fs:SetText(Theme:Hex(Theme.textMuted) .. "Kein BiS-Datenstand geladen.|r" .. DiagSuffix(GM)); fs:Show(); y = y - ROW_STEP
         end
     end
 
@@ -401,7 +416,7 @@ function UI:DrawFarm(content)
             y = y - 12
