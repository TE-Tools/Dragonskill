-        self.text:SetText(self.text:GetText() .. "\n" .. Theme:Hex(Theme.textMuted) .. "Keine Farm-Daten geladen.|r")
+        self.text:SetText(self.text:GetText() .. "\n" .. Theme:Hex(Theme.textMuted) .. "Keine Farm-Daten geladen.|r" .. DiagSuffix(GM))
