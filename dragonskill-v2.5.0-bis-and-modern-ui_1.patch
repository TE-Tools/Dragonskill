+            local fs = self:GetExtraFS(60); fs:SetPoint("TOPLEFT", 15, y); fs:SetText(Theme:Hex(Theme.textMuted) .. "Keine Upgrades verfügbar.|r" .. DiagSuffix(GM)); fs:Show()
